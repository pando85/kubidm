{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  configMigration: true,
  dependencyDashboard: true,
  // Keep npm and Python lockfiles on the existing dependency-update workflow.
  lockFileMaintenance: {
    enabled: false,
  },
  cargo: {
    lockFileMaintenance: {
      enabled: true,
      schedule: ['before 4am on monday'],
      automerge: false,
    },
  },
  'pre-commit': {
    enabled: true,
    commitMessagePrefix: 'pre-commit: ',
    branchPrefix: 'pre-commit-',
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Process custom dependencies in Rust',
      managerFilePatterns: [
        '/.+\\.rs$/',
      ],
      matchStrings: [
        '//\\srenovate: datasource=(?<datasource>\\S+)( versioning=(?<versioning>\\S+))?\n.*?= "(?<depName>\\S+):(?<currentValue>.*)";\n',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Process custom dependencies in Yaml',
      managerFilePatterns: [
        '/.+\\.yaml$/',
        '/.+\\.yml$/',
      ],
      matchStrings: [
        '#\\srenovate: datasource=(?<datasource>\\S+)( versioning=(?<versioning>\\S+))?\n.*?: (?<depName>\\S+):(?<currentValue>.*)\n',
        '#\\srenovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?: (?<currentValue>.*)\n',
        '#\\srenovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?=\\S+(?<currentValue>.*)\n',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
  ],
  packageRules: [
    {
      commitMessagePrefix: 'build(deps): ',
      matchPackageNames: [
        '/.*/',
      ],
    },
    {
      description: 'Ignore aliased dependencies in patches that must stay on old versions',
      matchFileNames: [
        'patches/**',
      ],
      matchPackageNames: [
        'http-body',
        'http',
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      matchCurrentVersion: '!/^0/',
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
      platformAutomerge: true,
      matchPackageNames: [
        '/.*/',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '!/^0/',
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
      platformAutomerge: true,
      matchPackageNames: [
        '/.*/',
      ],
    },
    {
      description: 'Automerge stable Cargo patch/minor updates only after CI and 14 days',
      matchManagers: ['cargo'],
      matchCurrentVersion: '!/^0/',
      matchUpdateTypes: ['patch', 'minor'],
      minimumReleaseAge: '14 days',
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
      ignoreTests: false,
    },
    {
      matchPackageNames: [
        '/opentelemetry/',
        'tracing-opentelemetry',
      ],
      groupName: 'opentelemetry',
      groupSlug: 'opentelemetry',
    },
    {
      matchPackageNames: [
        'askama',
        'askama_web',
      ],
      groupName: 'askama',
      groupSlug: 'askama',
    },
    {
      matchPackageNames: [
        'renovatebot/pre-commit-hooks',
      ],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
      platformAutomerge: true,
      schedule: [
        'after 4am and before 10am on the first day of the month',
      ],
      enabled: true,
    },
    {
      matchDatasources: [
        'docker',
      ],
      versioning: 'loose',
      matchPackageNames: [
        '/debian/',
      ],
    },
    {
      description: 'Manually review all pre-1.0 Cargo dependency updates',
      matchManagers: ['cargo'],
      matchCurrentVersion: '/^0\\./',
      automerge: false,
    },
    {
      description: 'Manually review authentication and cryptography updates',
      matchManagers: ['cargo'],
      matchPackageNames: [
        'argon2',
        'rustls',
        'tokio-rustls',
        'kanidm-hsm-crypto',
        'compact_jwt',
        'sha-crypt',
        'yescrypt',
        '/^webauthn-/',
        '/^ldap3_/',
      ],
      automerge: false,
    },
    {
      description: 'Never automerge breaking dependency updates',
      matchIsBreaking: true,
      automerge: false,
    },
    {
      description: 'Review Cargo lockfile maintenance manually; release age is not enforced for transitive dependencies',
      matchUpdateTypes: ['lockFileMaintenance'],
      automerge: false,
    },
    {
      description: 'Do not refresh the vendored AWS runtime lockfile',
      matchManagers: ['cargo'],
      matchFileNames: ['patches/aws-runtime-1.7.2/**'],
      matchUpdateTypes: ['lockFileMaintenance'],
      lockFileMaintenance: {
        enabled: false,
      },
    },
  ],
}
